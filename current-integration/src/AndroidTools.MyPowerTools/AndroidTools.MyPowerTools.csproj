<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The sibling src/MyPowerTools.Abstractions and src/MyPowerTools.Protocol copies are not
         materialized in this tree; the adapter consumes the same SDK packages every other
         current-integration adapter uses. -->
    <PackageReference Include="MyPowerTools.ToolSdk" Version="0.2.0" />
    <PackageReference Include="MyPowerTools.Protocol" Version="0.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ModulePackageRoot>$(MSBuildProjectDirectory)\..\..\modules\android-tools-suite</ModulePackageRoot>
  </PropertyGroup>

  <Target Name="CopyModuleAssemblyToPackage" AfterTargets="Build">
    <MakeDir Directories="$(ModulePackageRoot)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModulePackageRoot)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModulePackageRoot)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>

</Project>
