<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyPowerTools.UI.Controls"
             xmlns:vm="using:RemoteCommands.Surface.ViewModels"
             x:Class="RemoteCommands.Surface.Views.RemoteCommandsView"
             x:DataType="vm:RemoteCommandsViewModel"
             Background="{DynamicResource MptBrushTransparent}"
             MinHeight="520"
             ClipToBounds="True">
  <UserControl.Styles>
    <Style Selector="ListBox.history-list">
      <Setter Property="Background" Value="{DynamicResource MptBrushTransparent}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.history-list ListBoxItem">
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusControl}" />
    </Style>
    <Style Selector="ListBox.history-list ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource MptBrushControlFillHover}" />
    </Style>
    <Style Selector="ListBox.history-list ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource MptBrushControlFillPressed}" />
    </Style>
    <Style Selector="TextBox.command-input">
      <Setter Property="FontFamily" Value="Consolas, Cascadia Code, monospace" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </UserControl.Styles>

  <Grid MaxWidth="1280"
        HorizontalAlignment="Stretch"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="8"
        Margin="{DynamicResource MptCompactPadding}">
    <Grid Grid.Row="0"
          ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          ColumnSpacing="8"
          MinHeight="40">
      <TextBlock Text="Command:"
                 VerticalAlignment="Center"
                 Classes="MptMeta" />
      <ComboBox Grid.Column="1"
                ItemsSource="{Binding Commands}"
                SelectedIndex="{Binding SelectedCommandIndex}"
                DisplayMemberBinding="{Binding Label}"
                MinWidth="280"
                MaxWidth="420"
                VerticalAlignment="Center"
                ToolTip.Tip="{Binding SelectedCommand.Description}" />
      <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  Spacing="6"
                  VerticalAlignment="Center"
                  IsVisible="{Binding UsesRemoteHost}">
        <TextBlock Text="Host:"
                   VerticalAlignment="Center"
                   Classes="MptMeta" />
        <ComboBox ItemsSource="{Binding HostOptions}"
                  SelectedItem="{Binding Host, Mode=TwoWay}"
                  Width="170"
                  VerticalAlignment="Center"
                  IsEnabled="{Binding IsHostSelectionEnabled}"
                  ToolTip.Tip="{Binding HostSelectionHint}" />
      </StackPanel>
      <controls:MptButton Grid.Column="3"
                          Content="Run"
                          Classes="MptPrimaryButton"
                          Click="OnRunClick"
                          IsEnabled="{Binding !IsRunning}" />
      <controls:MptButton Grid.Column="4"
                          Content="Re-run"
                          Click="OnRerunClick"
                          IsEnabled="{Binding CanRerun}" />
      <controls:MptButton Grid.Column="5"
                          Content="Cancel"
                          Click="OnCancelClick"
                          IsEnabled="{Binding IsRunning}" />
      <controls:MptButton Grid.Column="6"
                          Content="Copy"
                          Click="OnCopyClick"
                          IsEnabled="{Binding !IsRunning}" />
      <controls:MptButton Grid.Column="7"
                          Content="Clear"
                          Click="OnClearOutputClick"
                          IsEnabled="{Binding !IsRunning}" />
      <controls:MptButton Grid.Column="8"
                          Content="Edit commands"
                          Click="OnEditYamlClick" />
      <controls:MptButton Grid.Column="9"
                          Content="Hosts &amp; settings"
                          Click="OnSettingsClick" />
    </Grid>

    <Grid Grid.Row="1"
          ColumnDefinitions="*,320"
          ColumnSpacing="10">
      <Border Grid.Column="0"
              Padding="12"
              CornerRadius="{DynamicResource MptRadiusCard}"
              BorderBrush="{DynamicResource MptBrushBorder}"
              BorderThickness="1"
              Background="{DynamicResource MptBrushCardBackground}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
              RowSpacing="8">
          <Grid ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="8">
            <TextBlock Text="{Binding Input1Label}"
                       Classes="MptSectionTitle"
                       VerticalAlignment="Center" />
            <controls:MptCheckBox Grid.Column="1"
                                  Content="Show second input"
                                  IsChecked="{Binding IsSecondInputVisible, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
            <controls:MptButton Grid.Column="2"
                                Content="Open commands file"
                                Click="OnExternalEditorClick"
                                VerticalAlignment="Center" />
          </Grid>

          <TextBox Grid.Row="1"
                   Classes="command-input"
                   Text="{Binding Input1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="110"
                   MaxHeight="220"
                   Watermark="{Binding Input1Placeholder}"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

          <TextBlock Grid.Row="2"
                     Text="{Binding Input2Label}"
                     Classes="MptSectionTitle"
                     IsVisible="{Binding IsSecondInputVisible}" />

          <TextBox Grid.Row="3"
                   Classes="command-input"
                   Text="{Binding Input2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="80"
                   MaxHeight="180"
                   Watermark="{Binding Input2Placeholder}"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   IsVisible="{Binding IsSecondInputVisible}" />

          <TextBlock Grid.Row="4"
                     Text="Output"
                     Classes="MptSectionTitle" />

          <TextBox Grid.Row="5"
                   Classes="command-input"
                   Text="{Binding Output, Mode=OneWay}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   IsReadOnly="True"
                   Watermark="Command output appears here."
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   MinHeight="150" />
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Padding="10"
              CornerRadius="{DynamicResource MptRadiusCard}"
              BorderBrush="{DynamicResource MptBrushBorder}"
              BorderThickness="1"
              Background="{DynamicResource MptBrushCardBackground}">
        <Grid RowDefinitions="Auto,Auto,*,Auto"
              RowSpacing="8">
          <TextBlock Text="History"
                     Classes="MptSectionTitle" />
          <controls:MptTextBox Grid.Row="1"
                               Text="{Binding HistorySearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               PlaceholderText="Search history..." />
          <ListBox Grid.Row="2"
                   Classes="history-list"
                   ItemsSource="{Binding FilteredHistoryItems}"
                   DoubleTapped="OnHistoryDoubleTapped"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2">
                  <TextBlock Classes="MptMeta"
                             Text="{Binding Timestamp}" />
                  <TextBlock Text="{Binding Label}"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="MptMeta"
                             Text="{Binding Host}" />
                  <TextBlock Classes="MptMeta"
                             Text="{Binding Output}"
                             MaxLines="2"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <controls:MptButton Grid.Row="3"
                              Content="Clear history"
                              Click="OnClearHistoryClick"
                              HorizontalAlignment="Stretch" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2"
          ColumnDefinitions="*,Auto">
      <TextBlock Text="{Binding StatusText}"
                 Classes="MptMeta"
                 VerticalAlignment="Center" />
      <TextBlock Grid.Column="1"
                 Text="{Binding SelectedCommand.Description}"
                 Classes="MptMeta"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
    </Grid>
  </Grid>
</UserControl>
