<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MyPowerTools.UI.Controls"
        x:Class="RemoteCommands.Surface.Views.CommandsYamlEditorDialog"
        Title="Remote Commands catalog"
        Width="920"
        Height="700"
        MinWidth="640"
        MinHeight="460"
        Background="{DynamicResource MptBrushAppBackground}"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto,Auto"
        RowSpacing="10"
        Margin="16">
    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="12">
      <StackPanel Spacing="3">
        <TextBlock Text="commands.yaml"
                   FontSize="20"
                   FontWeight="SemiBold" />
        <TextBlock Text="Schema 2 declares the runner, inputs, arguments, timeout, group, tags, and optional environment. Legacy shell and py entries remain supported."
                   Classes="MptMeta"
                   TextWrapping="Wrap" />
      </StackPanel>
      <WrapPanel Grid.Column="1"
                 Orientation="Horizontal"
                 ItemSpacing="8"
                 LineSpacing="8"
                 VerticalAlignment="Center">
        <controls:MptButton Content="Validate"
                            Click="OnValidateClick" />
        <controls:MptButton Content="Insert SSH example"
                            Click="OnInsertSshClick" />
        <controls:MptButton Content="Insert local example"
                            Click="OnInsertLocalClick" />
      </WrapPanel>
    </Grid>

    <TextBox Grid.Row="1"
             x:Name="Editor"
             AcceptsReturn="True"
             TextWrapping="NoWrap"
             FontFamily="Cascadia Code, Consolas, monospace"
             FontSize="13"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollBarVisibility="Auto" />

    <TextBlock Grid.Row="2"
               x:Name="ValidationText"
               Classes="MptMeta"
               TextWrapping="Wrap" />

    <Grid Grid.Row="3"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="12">
      <TextBlock Text="Placeholders use input:id:text for quoted text and input:id:file for temporary-file paths."
                 Classes="MptMeta"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center" />
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="8"
                  HorizontalAlignment="Right">
        <controls:MptButton Content="Save catalog"
                            Classes="MptPrimaryButton"
                            Click="OnSaveClick" />
        <controls:MptButton Content="Cancel"
                            Click="OnCancelClick" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
