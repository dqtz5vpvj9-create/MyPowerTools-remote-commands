<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MyPowerTools.UI.Controls"
        x:Class="RemoteCommands.Surface.Views.CommandsYamlEditorDialog"
        Title="Edit commands.yaml"
        Width="760"
        Height="560"
        MinWidth="560"
        MinHeight="400"
        Background="{DynamicResource MptBrushAppBackground}"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto,Auto"
        RowSpacing="8"
        Margin="12">
    <TextBox x:Name="Editor"
             AcceptsReturn="True"
             TextWrapping="NoWrap"
             FontFamily="Consolas, Cascadia Code, monospace"
             FontSize="13"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollBarVisibility="Auto" />
    <TextBlock Grid.Row="1"
               x:Name="ErrorText"
               Classes="MptMeta"
               Foreground="{DynamicResource MptBrushDanger}"
               TextWrapping="Wrap"
               IsVisible="False" />
    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Right">
      <controls:MptButton Content="Save"
                          Classes="MptPrimaryButton"
                          Click="OnSaveClick" />
      <controls:MptButton Content="Cancel"
                          Click="OnCancelClick" />
    </StackPanel>
  </Grid>
</Window>
